# Copy this file to ".env" if your backend does NOT run on http://localhost:5000

# Where the Vite dev server forwards /api requests (development only)
VITE_BACKEND_URL=http://localhost:5000

# Optional: full API base URL for a deployed build (e.g. https://your-api.onrender.com/api)
# Leave empty during local development so the proxy above is used.
VITE_API_URL=
